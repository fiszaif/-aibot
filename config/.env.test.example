# Test Environment Configuration
# Copy this file to the project root as .env.test and fill in your actual Binance Testnet API keys.

# Binance API Credentials (TESTNET ONLY FOR INTEGRATION TESTS)
BINANCE_API_KEY="YOUR_TESTNET_API_KEY"
BINANCE_API_SECRET="YOUR_TESTNET_API_SECRET"

# PostgreSQL Database Connection (use a DEDICATED TEST DATABASE)
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="your_db_user"        # Can be same user as dev, but different DB_NAME
DB_PASSWORD="your_db_password"
DB_NAME="binance_tracker_db_test" # IMPORTANT: Use a separate test database
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Scheduler Intervals for faster testing (e.g., 0.2 minutes = 12 seconds)
SCHED_BALANCE_INTERVAL_MINUTES=0.2
SCHED_POSITIONS_INTERVAL_MINUTES=0.2
SCHED_TRADES_INTERVAL_MINUTES=0.2
SCHED_TRADE_SYMBOLS="BTCUSDT,ETHUSDT" # Ensure these are active on Testnet
SCHED_USE_TESTNET=True

# General App Settings
LOG_LEVEL="INFO" # Or DEBUG for more verbose test output
