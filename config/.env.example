# Binance API Credentials
# Copy this file to .env in the root directory and fill in your actual API key and secret.
# DO NOT commit your actual .env file to version control.
BINANCE_API_KEY="YOUR_API_KEY"
BINANCE_API_SECRET="YOUR_API_SECRET"

# PostgreSQL Database Connection
# Ensure you have PostgreSQL server installed and running.
# Create a database (e.g., binance_tracker_db) and a user with privileges for this database.
# Then, update the following connection details.
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"
DB_NAME="binance_tracker_db"
# The DATABASE_URL is constructed from the above variables by the application.
# You can also set it directly if you prefer, and it will be prioritized.
# Example: DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/binance_tracker_db"
DATABASE_URL="" 

# Scheduler Intervals (in minutes)
SCHED_BALANCE_INTERVAL_MINUTES=15
SCHED_POSITIONS_INTERVAL_MINUTES=5
SCHED_TRADES_INTERVAL_MINUTES=10
# Comma-separated list of symbols for fetching trades, e.g., BTCUSDT,ETHUSDT
SCHED_TRADE_SYMBOLS="BTCUSDT,ETHUSDT"
# Set to True to use Binance Testnet for the scheduler, False for Mainnet
SCHED_USE_TESTNET=True
